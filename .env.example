APP_NAME="PsicoScreen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------
# MySQL — reemplazar con credenciales de cPanel
# ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=psicoscreen
DB_USERNAME=psicoscreen_user
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----------------------------------------------------------------
# Colas con driver "database" → compatible con cron en cPanel
# ----------------------------------------------------------------
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=psicoscreen_

# ----------------------------------------------------------------
# SMTP — configurar con cuenta de cPanel / Mailgun / etc.
# ----------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.midominio.com
MAIL_PORT=465
MAIL_USERNAME=noreply@midominio.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@midominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------
# Tokens de paciente
# ----------------------------------------------------------------
SCREENING_TOKEN_TTL_HOURS=72

VITE_APP_NAME="${APP_NAME}"
