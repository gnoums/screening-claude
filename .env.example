APP_NAME="PsicoScreen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://app.dev2byroca.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ----------------------------------------------------------------
# MySQL — credenciales del cPanel
# Formato cPanel: usuario_dbname / usuario_dbuser
# ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tu_usuario_psicoscreen
DB_USERNAME=tu_usuario_dbuser
DB_PASSWORD=CAMBIA_ESTO

# ----------------------------------------------------------------
# Sesiones y seguridad
# ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=app.dev2byroca.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----------------------------------------------------------------
# Colas — driver "database" compatible con cron de cPanel
# No requiere Redis ni workers persistentes
# ----------------------------------------------------------------
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=psicoscreen_

# ----------------------------------------------------------------
# Correo transaccional — elige UNA de las dos opciones
# ----------------------------------------------------------------

# OPCIÓN A: Resend (recomendado en cPanel — funciona sobre HTTPS, nunca bloqueado)
# 1. Crea cuenta en resend.com
# 2. Agrega tu dominio y añade los registros DNS que te indiquen
# 3. Crea un API Key en resend.com → API Keys
# 4. Instala el driver: composer require resend/resend-php
MAIL_MAILER=resend
RESEND_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXX
MAIL_FROM_ADDRESS="noreply@dev2byroca.com"
MAIL_FROM_NAME="${APP_NAME}"

# OPCIÓN B: Zoho SMTP directo (solo si tu hosting permite puerto 465 o 587 saliente)
# Si usas esta opción, comenta la sección de Resend de arriba y descomenta esto:
#
# Prerrequisitos:
#   1. Verificar dominio en Zoho Mail Admin Console
#   2. Crear dirección noreply@dev2byroca.com
#   3. Habilitar SMTP: Zoho → Configuración → Seguridad → Contraseñas de aplicación
#   4. Usar la contraseña de aplicación (no la de tu cuenta)
#
# Puerto 465 (SSL):  MAIL_SCHEME=smtps  MAIL_PORT=465
# Puerto 587 (TLS):  MAIL_SCHEME=tls    MAIL_PORT=587
#MAIL_MAILER=smtp
#MAIL_SCHEME=smtps
#MAIL_HOST=smtp.zoho.com
#MAIL_PORT=465
#MAIL_USERNAME=noreply@dev2byroca.com
#MAIL_PASSWORD=CONTRASEÑA_DE_APLICACION_ZOHO
#MAIL_FROM_ADDRESS="noreply@dev2byroca.com"
#MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------
# Stripe
# Claves live: Dashboard → Developers → API keys
# Webhook secret: Dashboard → Developers → Webhooks → tu endpoint → Signing secret
#
# Endpoint a registrar en Stripe Dashboard:
#   https://app.dev2byroca.com/stripe/webhook
# Eventos a escuchar: checkout.session.completed
# ----------------------------------------------------------------
STRIPE_KEY=pegar_aqui_tu_publishable_key
STRIPE_SECRET=pegar_aqui_tu_secret_key
STRIPE_WEBHOOK_SECRET=pegar_aqui_tu_webhook_signing_secret

# IDs de precios de Stripe (crear en Dashboard → Products → Add product → One time)
STRIPE_PRICE_CREDITS_10=pegar_aqui_price_id_10_creditos
STRIPE_PRICE_CREDITS_30=pegar_aqui_price_id_30_creditos
STRIPE_PRICE_CREDITS_100=pegar_aqui_price_id_100_creditos

# ----------------------------------------------------------------
# Tokens de tamizaje
# ----------------------------------------------------------------
SCREENING_TOKEN_TTL_HOURS=72

VITE_APP_NAME="${APP_NAME}"
